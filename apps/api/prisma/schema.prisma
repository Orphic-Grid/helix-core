generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  EMERGENCY_STAFF
  PATIENT
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String        @map("full_name")
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole
  hospitalId   String?       @map("hospital_id") @db.Uuid
  department   String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  hospital     Hospital?     @relation(fields: [hospitalId], references: [id])
  sessions     UserSession[]
  auditLogs    AccessLog[]

  @@map("users")
}

model Hospital {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  type        String
  address     String?
  syncEnabled Boolean         @default(true) @map("sync_enabled")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  users       User[]
  auditLogs   AccessLog[]
  consents    ConsentRecord[]

  @@map("hospitals")
}

model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  ipAddress        String?  @map("ip_address")
  deviceInfo       String?  @map("device_info")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AccessLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  patientId         String?   @map("patient_id")
  action            String
  sourceHospitalId  String?   @map("source_hospital") @db.Uuid
  emergencyOverride Boolean   @default(false) @map("emergency_override")
  ipAddress         String?   @map("ip_address")
  metadata          Json      @default("{}")
  timestamp         DateTime  @default(now()) @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceHospital    Hospital? @relation(fields: [sourceHospitalId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([userId])
  @@index([patientId])
  @@map("audit_logs")
}

model Permission {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role                UserRole @unique
  canViewPatient      Boolean  @default(false) @map("can_view_patient")
  canManageUsers      Boolean  @default(false) @map("can_manage_users")
  canUseEmergencyMode Boolean  @default(false) @map("can_use_emergency_mode")
  canExportData       Boolean  @default(false) @map("can_export_data")

  @@map("permissions")
}

model ConsentRecord {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId         String    @map("patient_id")
  grantedToHospital String?   @map("granted_to_hospital") @db.Uuid
  consentScope      String    @map("consent_scope")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  hospital          Hospital? @relation(fields: [grantedToHospital], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("consent_records")
}
